[Unit]
Description=Server Watcher GPU and system dashboard
After=network-online.target ssh.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/server-watcher
Environment=NODE_ENV=production
Environment=WATCHER_HOST=0.0.0.0
Environment=WATCHER_PORT=33099
Environment=WATCHER_SSH_HOST=127.0.0.1
Environment=WATCHER_SSH_PORT=22
Environment=WATCHER_STORAGE_ROOTS=/home
Environment=WATCHER_DATA_DIR=/opt/server-watcher/data
ExecStart=/usr/bin/node backend/dist/server.js
Restart=on-failure
RestartSec=3
User=server-watcher
Group=server-watcher
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/server-watcher/data

[Install]
WantedBy=multi-user.target
