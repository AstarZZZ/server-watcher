WATCHER_HOST=0.0.0.0
WATCHER_PORT=33099
WATCHER_SSH_HOST=127.0.0.1
WATCHER_SSH_PORT=22
WATCHER_SESSION_HOURS=12
WATCHER_SECURE_COOKIES=false

# Optional: allow only members of these Linux groups to log in.
# WATCHER_ALLOWED_GROUPS=sudo,gpuwatcher

# Storage scan defaults to /home and runs when the server clock hour is 2.
WATCHER_STORAGE_ROOTS=/home
WATCHER_STORAGE_SCAN_HOUR=2

# Runtime data, logs, and storage snapshots.
WATCHER_DATA_DIR=./data

# Keep the process table compact.
WATCHER_PROCESS_LIMIT=250
